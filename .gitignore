# ─── 4. IMÁGENES (salvo figuras agregadas del paper — ver excepciones §7) ──
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.bmp
*.gif
*.dicom

# ─── 5. DOCUMENTOS QUE PUEDEN CONTENER DATOS DE PACIENTES ──────────────────
*.docx
*.doc
*.pptx
*.ppt

# ─── 6. NOTEBOOKS: los .ipynb SÍ se versionan, pero sin outputs ────────────
# (limpiar con `nbstripout` antes de commitear — ver README §Higiene)
.ipynb_checkpoints/
*-checkpoint.ipynb

# ─── 7. EXCEPCIONES: lo que SÍ se versiona ─────────────────────────────────
# Figuras agregadas del paper (sin datos identificables) y resultados agregados.
!011_mri_estructural_fase5/figs/**/*.png
!011_mri_estructural_fase5/figs/**/*.pdf
!011_mri_estructural_fase5/figs/**/*.svg
# Tablas de RESULTADOS agregados (estadísticos por ROI, nunca filas por sujeto).
# Se habilitan una por una y de forma explícita, nunca con comodín:
!011_mri_estructural_fase5/results/**/*_resultados_*.csv
!011_mri_estructural_fase5/results/**/*_efectos_*.csv
# Entorno y configuración
!requirements.txt
!**/requirements.txt

# ─── 8. PYTHON / ENTORNO ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.env
.env.*
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

